<?xml version="1.0" encoding="utf-8"?>
<!--
  The backend is reached over plain HTTP, and Android has blocked cleartext
  traffic by default since API 28 (this app targets 35). Without this the app
  installs and launches but every request fails with "Cleartext HTTP traffic
  not permitted".

  Rather than switching cleartext on globally with usesCleartextTraffic, which
  would let any origin be reached over HTTP, this allows it only for the
  loopback hosts the app genuinely dials:

    127.0.0.1 / localhost  the backend, tunnelled over USB with
                          `adb reverse tcp:8000 tcp:8000`
    10.0.2.2               the host machine as seen from an Android emulator

  Everything else, including any real remote origin, stays HTTPS-only. Pointing
  the app at a LAN address instead means adding that host here, since the
  Network Security Config matches exact hosts and cannot express a CIDR range.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>