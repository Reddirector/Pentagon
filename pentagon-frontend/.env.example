# Where the dev server proxies /api to. Browser code must NOT read this — it
# names the proxy target, not an origin the client is allowed to dial.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Origin the packaged iOS/Android shells dial. Leave empty to make every user
# type their backend address in Settings → Backend on first run. On a LAN that
# looks like http://192.168.1.20:8000.
VITE_PENTAGON_API_BASE=

# Supabase project settings — from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Capability token -- only needed when you run Pentagon in a plain browser
# (the Vite dev server) instead of the desktop app.
#
# The desktop app reads this secret from disk in its main process and hands it
# to the page over IPC, so it needs nothing here. A browser has no such
# bridge, so it cannot call /api/commands (approvals, desktop control,
# location) at all and the Commands tab shows as unavailable.
#
# To enable it in a browser, paste the contents of the backend's token file:
#   cat ~/.config/pentagon/capability-token
# Only do this on a machine you trust -- anything able to read this file can
# approve commands on your behalf.
VITE_PENTAGON_CAPABILITY=
