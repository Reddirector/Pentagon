# Xcode / CocoaPods build output. The project, workspace and Podfile are
# tracked so `npm run mobile:ios` works from a fresh clone; everything below is
# regenerated by `pod install` and `xcodebuild` on the machine doing the build.

# Build products
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods: `pod install` recreates these from the Podfile.lock that is kept.
Pods/
Podfile.lock
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Xcode per-user state
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.swp

# Signing material must never be committed
*.mobileprovision
*.p12
*.cer

# macOS
.DS_Store