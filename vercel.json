{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "pentagon-frontend": {
      "root": "pentagon-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "pentagon-frontend"
      }
    }
  ]
}
