{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd pentagon-frontend && npm run build",
  "outputDirectory": "pentagon-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__route=$1"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
