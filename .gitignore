# Python virtualenv (the local `pentagon/` dir is ~2 GB)
pentagon/
venv/
.venv/

# Secrets — never commit real keys
.env
.env.*
!.env.example
*.pem
*.key
.env.keys

# Node / frontend build output
node_modules/
dist/
dist-ssr/
release/
.vite/
# Standalone Electron binary downloaded for local smoke tests (~283 MB)
pentagon-frontend/electron-download/
.freebuff/
release-staging/

# Local databases and generated data
*.db
# SQLite WAL/SHM sidecars (runtime state of a live pentagon.db)
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
chroma_data/
image_uploads/
speech_models/
sandbox/
# ...but the code sandbox Dockerfile is source: keep the backend's in.
!pentagon-backend/sandbox/
# Agent-generated artifacts (create_artifact) and generated_files are runtime output.
artifacts/
generated_files/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Tooling / editor
Anthropic-Cybersecurity-Skills/
.gradle/
.idea/
.vscode/
.DS_Store
*.swp

# Local dev samples and scratch
dev_samples/
*.log
npm-debug.log*
# Preserved local history of the old nested backend repo (not published)
.git.local-backup/

# User-created skills (Settings -> Skills) are runtime data, like pentagon.db.
pentagon-backend/skills/user/
.vercel
