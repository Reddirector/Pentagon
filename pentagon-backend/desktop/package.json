{
  "name": "pentagon-desktop",
  "description": "Desktop chat workspace for the Pentagon backend",
  "desktopName": "Pentagon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "lint": "oxlint src electron",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs --dev\"",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.pentagon.chat",
    "productName": "Pentagon",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json", "node_modules/**/*"],
    "linux": { "target": ["AppImage"], "category": "Utility", "syncDesktopName": true },
    "mac": { "target": ["dmg"] },
    "win": { "target": ["nsis"] }
  }
}
