[TEMPLATE]
# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_SECRET=replace-with-a-generated-fernet-key
DATABASE_URL=sqlite:///./pentagon.db
TAVILY_API_KEY=
CHROMA_PERSIST_DIRECTORY=./chroma_data
IMAGE_UPLOADS_DIRECTORY=./image_uploads
VIDEO_SAMPLING_FPS=1.0
VIDEO_MAX_DURATION_SECONDS=60
SPEECH_MODELS_DIRECTORY=./speech_models
FASTER_WHISPER_MODEL=base
LOCAL_TTS_VOICE=en_US-lessac-medium
# Optional NVIDIA Speech NIM HTTP base URLs. Without accessible endpoints,
# speech uses local faster-whisper and Piper fallbacks.
NVIDIA_RIVA_ASR_URL=
NVIDIA_RIVA_TTS_URL=
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Supabase (server-side only — never expose the service role key in the frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Optional server-side NVIDIA fallback key so the app works before the user stores their own key.
# DEFAULT_CHAT_MODEL must be a real id in the live catalog (verified at build time).
NVIDIA_SERVER_API_KEY=
DEFAULT_CHAT_MODEL=z-ai/glm-5.3-flash
