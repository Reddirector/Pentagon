# Backend configuration. Copy to `.env` and fill in. Never commit the result.

# --- Required ---------------------------------------------------------------

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts stored API keys at rest. Changing it makes existing keys unreadable.
KEY_ENCRYPTION_SECRET=replace-with-a-generated-fernet-key

# --- Storage ----------------------------------------------------------------

DATABASE_URL=sqlite:///./pentagon.db
CHROMA_PERSIST_DIRECTORY=./chroma_data
# Note the singular "UPLOAD": it matches `image_upload_directory` in app/config.py.
IMAGE_UPLOAD_DIRECTORY=./image_uploads
SPEECH_MODELS_DIRECTORY=./speech_models

# --- NVIDIA -----------------------------------------------------------------

# Optional server-side fallback so the app works before a user stores their own
# key. Users can still bring their own key from Settings -> Account.
NVIDIA_SERVER_API_KEY=
# Must be a real id in the live catalog, or model discovery will fail.
DEFAULT_CHAT_MODEL=z-ai/glm-5.3-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Reasoning models can take 2-3 minutes to produce a first token. 30s kills them.
NVIDIA_TIMEOUT_SECONDS=300

# --- Retrieval --------------------------------------------------------------

# Local embeddings need no API and are the fallback whenever the pinned
# embedding model stops working. Downloaded once on first use.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Web search -------------------------------------------------------------

# Optional. Web search runs without a key via DuckDuckGo; Tavily is a fallback.
TAVILY_API_KEY=

# --- Media ------------------------------------------------------------------

VIDEO_SAMPLING_FPS=1.0
VIDEO_MAX_DURATION_SECONDS=60
FASTER_WHISPER_MODEL=base
LOCAL_TTS_VOICE=en_US-lessac-medium
# Optional NVIDIA Speech NIM endpoints. Without reachable ones, speech falls back
# to local faster-whisper and Piper.
NVIDIA_RIVA_ASR_URL=
NVIDIA_RIVA_TTS_URL=

# --- Supabase (optional, server side only) -----------------------------------

# Never expose the service role key to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# --- Browser and native WebView origins (optional) ----------------------------

# The web and desktop builds are same-origin and need nothing here. The iOS and
# Android apps load from their own bundled origin, so they are cross-origin and
# the browser engine blocks them without an explicit allowance. Defaults to
# capacitor://localhost,http://localhost,https://localhost. Add any hosted
# frontend or LAN address as a comma-separated list.
CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost
