# Backend configuration. Copy to `.env` and fill in. Never commit the result.

# --- Required ---------------------------------------------------------------

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts stored API keys at rest. Changing it makes existing keys unreadable.
KEY_ENCRYPTION_SECRET=replace-with-a-generated-fernet-key

# --- Storage ----------------------------------------------------------------

DATABASE_URL=sqlite:///./pentagon.db
CHROMA_PERSIST_DIRECTORY=./chroma_data
# Note the singular "UPLOAD": it matches `image_upload_directory` in app/config.py.
IMAGE_UPLOAD_DIRECTORY=./image_uploads
SPEECH_MODELS_DIRECTORY=./speech_models

# --- NVIDIA -----------------------------------------------------------------

# Optional server-side fallback so the app works before a user stores their own
# key. Users can still bring their own key from Settings -> Account.
NVIDIA_SERVER_API_KEY=
# Must be a real id in the live catalog, or model discovery will fail.
DEFAULT_CHAT_MODEL=z-ai/glm-5.3-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Reasoning models can take 2-3 minutes to produce a first token. 30s kills them.
NVIDIA_TIMEOUT_SECONDS=300

# --- Retrieval --------------------------------------------------------------

# Local embeddings need no API and are the fallback whenever the pinned
# embedding model stops working. Downloaded once on first use.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Web search -------------------------------------------------------------

# Optional. Web search runs without a key via DuckDuckGo; Tavily is a fallback.
TAVILY_API_KEY=

# --- Media ------------------------------------------------------------------

VIDEO_SAMPLING_FPS=1.0
# How much of an uploaded video is analysed. Long clips are sampled more
# sparsely rather than rejected.
VIDEO_MAX_DURATION_SECONDS=600
# Ceiling on an uploaded video. This can lower the limit but never raise it
# past the hard cap in video.py.
VIDEO_MAX_BYTES=125829120
FASTER_WHISPER_MODEL=base
LOCAL_TTS_VOICE=en_US-lessac-medium
# Optional NVIDIA Speech NIM endpoints. Without reachable ones, speech falls back
# to local faster-whisper and Piper.
NVIDIA_RIVA_ASR_URL=
NVIDIA_RIVA_TTS_URL=

# --- Command tool (optional, off by default) --------------------------------

# Lets the model run CLI commands. Off by default: the tool is never offered
# unless this is true, whatever any client asks for. Even then each user must
# opt in from Settings -> Commands.
#
# Read-only commands (ls, cat, grep, git status, ...) run immediately.
# Everything else shows the exact command in the chat and waits for a decision;
# if nobody answers before COMMAND_APPROVAL_TIMEOUT_SECONDS it does not run.
COMMAND_TOOL_ENABLED=false
COMMAND_APPROVAL_TIMEOUT_SECONDS=300
COMMAND_TIMEOUT_SECONDS=120
# Ceiling on what one command can return to the model, so a runaway `cat` of a
# huge log cannot blow out the conversation.
COMMAND_MAX_OUTPUT_BYTES=20000
# Where commands run. Empty means the backend's own working directory.
COMMAND_WORKING_DIRECTORY=
# How many commands the model may request in one turn.
COMMAND_MAX_CALLS_PER_TURN=8

# --- Desktop control ---------------------------------------------------------
# A separate switch from the shell, because it can lock the screen or shut the
# machine down. It only takes effect when COMMAND_TOOL_ENABLED is also on and
# the user has opted in. With this on, the model can open and close apps, focus
# windows, take screenshots, change the volume, control playback, send
# notifications, switch dark mode and manage power. Listing windows runs
# unattended; everything else asks the user first, and silence denies it.
DESKTOP_ACTIONS_ENABLED=false
# Shorter than the shell timeout on purpose: the window you agreed to close
# five minutes ago may not be the one on screen now, so a late yes is worth
# less than a prompt no.
DESKTOP_ACTION_APPROVAL_TIMEOUT_SECONDS=120
# Where screenshots land. Empty means the system temp directory.
SCREENSHOT_DIRECTORY=
# Location. A separate switch, because "where is this person" is a different
# kind of question from "run this command". Only consulted when the model
# decides an answer needs it. This machine has no GPS, so a fallback is a
# coarse network estimate and the answer always says which source it used.
LOCATION_ENABLED=false
# Where the capability token lives. Empty means
# $XDG_CONFIG_HOME/pentagon/capability-token, created 0600 on first use.
CAPABILITY_TOKEN_PATH=

# --- Supabase (optional, server side only) -----------------------------------

# Never expose the service role key to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# --- Browser and native WebView origins (optional) ----------------------------

# The web and desktop builds are same-origin and need nothing here. The iOS and
# Android apps load from their own bundled origin, so they are cross-origin and
# the browser engine blocks them without an explicit allowance. Defaults to
# capacitor://localhost,http://localhost,https://localhost. Add any hosted
# frontend or LAN address as a comma-separated list.
CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost
